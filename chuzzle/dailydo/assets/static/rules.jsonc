// rules are deterministic per day. game type is selected for a pool for 35 and optional modifiers/bonus are drawn from separate daily seed RNG. 
// see chuzzle/dailydo/rules.js for the selection algorithm and gating (including rules 30/31 and rule 19's day of month gate thing)

// each day's output can be reproduced from the date seed, which makes tournament scheduling consistent!

// <color r,g,b>
// <color name>          colors like <color 0,1,0>, <color gold>

// <_tc>                 default text colour (rgba .8,.8,1,.85)
// <blinky>              shows color1 for [time] ticks then color2 for [time] ticks and repeats, so is just blinking!
// <_stinky>             red/yellow blink variant for scarey stinky endeavours

// <img ddgt_icon%d>
// <img ddrule_icon%d>
// <img ddbonus_icon%d>

{
    "gametype": [
        {"id": 0, "icon": "gametype/0classic", "name": "Classic Chuzzle",
            "color": "0,1,0",
            "text": "Plays like <color 0,1,0>Classic Chuzzle!<_tc>  Pop Chuzzles for as long as you can!"},
        {"id": 1, "icon": "gametype/1sunchuzzle", "name": "SunChuzzle",
            "color": "gold",
